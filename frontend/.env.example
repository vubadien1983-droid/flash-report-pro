# ═══════════════════════════════════════════════════════════════
# Flash Report Pro — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Firebase Configuration (Required for cloud sync)
# Get these from: https://console.firebase.google.com → Your Project → Settings → General → Your apps → Web app
VITE_FIREBASE_API_KEY=AIzaSy...your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# When all Firebase vars are set, the app uses Firestore + Storage for cloud sync.
# When empty/missing, the app falls back to legacy restful-api.dev backend.
